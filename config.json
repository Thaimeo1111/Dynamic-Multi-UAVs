      "max_travel_time": 1236.0
    },
    {
      "profile_id": "camera_only",
      "number": 8,
      "capabilities": [
        "camera"
      ],
      "speed": 1.0,
      "capacity": 200.0,
      "max_travel_time": 1236.0
    },
    {
      "profile_id": "multirole",
      "number": 9,
      "capabilities": [
        "payload",
        "camera",
        "emergency"
      ],
      "speed": 1.0,
      "capacity": 200.0,
      "max_travel_time": 1236.0
    }
  ]
}